---
layout: home
title: Blog
---

<main>
  <div class="container intro">
    <div class="col-3 author-image-container">
      <img
        class="author-image"
        src="{{ site.authorImage | cloudinary('c_limit,w_240,h_240/f_auto/q_auto') }}"
        alt="Author image"
      />
    </div>
    <div class="col-9 intro-text-container">
      <p class="intro-text">{{ site.description }}</p>
    </div>
  </div>

  {% for year, yearPosts in collections.postsByYear %}
  <h2 class="post-list-heading">{{ year }}</h2>
  <ul class="post-list">
    {% for post in yearPosts %}
    <li>
      <a class="post-link" href="{{ post.data.page.url }}">{{
        post.data.title
      }}</a>
      <a class="tag" href="/tags/{{ post.data.tags[1] }}">{{
        post.data.tags[1]
      }}</a>
    </li>
    {% endfor %}
  </ul>
  {% endfor %}
</main>
