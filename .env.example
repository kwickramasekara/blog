# Cloudinary product environment (Console -> Settings -> API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: only needed if you use a Cloudinary unsigned upload preset directly.
# Decap CMS's Cloudinary media library authenticates with the Cloudinary login
# instead of an upload preset.
CLOUDINARY_UPLOAD_PRESET=
